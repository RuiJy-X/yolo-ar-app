{
  "name": "Skysight",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron:dev": "electron .",
    "backend:dev": "backend\\act_reg_final_version\\.venv\\Scripts\\python.exe -m uvicorn websocket_api:app --host 127.0.0.1 --port 8000 --reload --app-dir backend/act_reg_final_version",
    "desktop:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-prepare.ps1",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win nsis --x64 --publish never && node scripts/desktop-checksum.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.14.0",
    "react-router-dom": "^7.15.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.0.1",
    "electron-builder": "26.0.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  },
  "description": "Skysight offline action recognition desktop application",
  "author": "Skysight",
  "build": {
    "appId": "com.skysight.desktop",
    "productName": "Skysight",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop-build/SkysightBackend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop-build/app.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Skysight-Setup-${version}.${ext}"
    },
    "npmRebuild": false
  }
}
